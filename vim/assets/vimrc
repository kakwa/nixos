" Generated by NixOS -- system-wide vim configuration (all users).
" User-specific ~/.vimrc files are still loaded afterwards and take
" precedence.

" Basic editing behaviour
set nocompatible " use Vim defaults, not vi-compatible mode (fixes E10)
set expandtab " On pressing tab, insert spaces
set shiftwidth=4 " when indenting with '>', use 4 spaces width
set tabstop=4 " show existing tab with 4 spaces width
set softtabstop=4 " treat 4 spaces as one tab when editing
set shiftround " round indent to multiple of shiftwidth
set autoindent " copy indent from current line when starting a new line
set smartindent " do smart autoindenting when starting a new line
set smarttab " leading tabs insert shiftwidth spaces
set backspace=indent,eol,start " allow sensible backspacing
set background=dark " dark background within the editing area

" $VIMRUNTIME refers to the versioned system directory where Vim stores its
" system runtime files -- /usr/share/vim/vim<version>.
"
" Vim will load $VIMRUNTIME/defaults.vim if the user does not have a vimrc.
" If you would rather _use_ defaults.vim's settings, but have this vimrc
" override its settings, uncomment both lines below.
" source $VIMRUNTIME/defaults.vim
" let g:skip_defaults_vim = 1

" Enable syntax highlighting by default
syntax on

set notgc

" Disable mouse usage (all modes)
set mouse=

" Load indentation rules and plugins according to the detected filetype
filetype plugin indent on

" Jump to the last position when reopening a file
au BufReadPost * if line("'\"") > 1 && line("'\"") <= line("$") | exe "normal! g'\"" | endif
